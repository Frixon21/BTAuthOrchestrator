# TCP port on which the HTTP service listens.
PORT=3000
# Directory reserved for PGlite data in a later task.
PGLITE_DATA_DIR=./data
# Encryption key reserved for database secrets in a later task.
DB_ENCRYPTION_KEY=replace-with-encryption-key
# Whether session cookies should use the Secure attribute in a later task.
COOKIE_SECURE=false
# Microsoft Entra tenant identifier for OIDC configuration. Required (and
# must be non-empty) only when LOCAL_LOGIN=false; not read at all when
# LOCAL_LOGIN=true (CONTRACT-005 §10).
TENANT_ID=00000000-0000-0000-0000-000000000000
# Microsoft Entra application client identifier for OIDC configuration. Same
# conditional requirement as TENANT_ID above (CONTRACT-005 §10).
CLIENT_ID=00000000-0000-0000-0000-000000000000
# Canonical session-token issuer; the production value must be https://orca.biztechro.com.
SERVICE_ISSUER=https://orca.biztechro.com
# Dedicated bearer credential for POST /admin/emergency-rotate-keys (CONTRACT-003).
# Distinct from any Entra identity, bt_session cookie, or CLIENT_SECRET. At least
# 32 characters; generate with, e.g., `openssl rand -hex 32`.
EMERGENCY_ROTATION_TOKEN=replace-with-emergency-rotation-token
# CONTRACT-005 mode switch: exactly "true" or "false" (case-insensitive),
# required with no implicit default. true = POST /auth/local-login is the
# live login path and Entra's GET /auth/login/GET /auth/callback are inert
# (generic 404); false = the reverse. Exactly one of the two paths is ever
# live. Recommended/example default is false (Entra-only), matching ordinary
# production use; set true only for local/test deployments.
LOCAL_LOGIN=false
# Dedicated bearer credential for the future POST/GET/PATCH/DELETE
# /admin/users* admin API (CONTRACT-005 §4, TASK-016). Distinct from
# EMERGENCY_ROTATION_TOKEN on least-privilege grounds. At least 32
# characters; generate with, e.g., `openssl rand -hex 32`.
LOCAL_USER_ADMIN_TOKEN=replace-with-local-user-admin-token

# The four variables below are optional (CONTRACT-005 §3): if present, each
# must be a positive integer or the process fails to start; if absent, the
# stated default applies silently. Uncomment to override.
# Consecutive failed password attempts against one local_users account
# before it is locked. Default: 10.
# LOCAL_LOGIN_MAX_FAILED_ATTEMPTS=10
# Minutes an account stays locked once LOCAL_LOGIN_MAX_FAILED_ATTEMPTS is
# reached. Default: 15.
# LOCAL_LOGIN_LOCKOUT_MINUTES=15
# Failed /auth/local-login attempts from one source IP, across all
# usernames, within the rolling window below, before that IP receives 429.
# Default: 20.
# LOCAL_LOGIN_IP_THROTTLE_MAX_ATTEMPTS=20
# Rolling window (minutes) the per-source-IP throttle counts attempts over.
# Default: 5.
# LOCAL_LOGIN_IP_THROTTLE_WINDOW_MINUTES=5

# Optional (CONTRACT-012). Comma-separated IP addresses or CIDR ranges of
# proxies allowed to report the client's address in CF-Connecting-IP. Leave
# unset when clients connect directly: the connection's own address is then
# used and forwarded headers are ignored. Behind the Cloudflare Tunnel, set it
# to the pinned subnet of the compose network shared with cloudflared.
# TRUSTED_PROXIES=172.30.10.0/29

# Permit public account creation via /auth/local-register and POST /admin/users.
# Only True (case-insensitive) enables saving. Restart after changing this value.
ALLOW_NEW_LOCAL_LOGIN_CREATION=True
